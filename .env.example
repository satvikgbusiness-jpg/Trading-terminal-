# ============================================================================
# GMT Terminal - environment
#
# Copy to .env.local and fill in what you have. The app runs with none of these
# set: crypto (CoinGecko) and FX (ECB via Frankfurter) are keyless, and every
# panel that cannot be filled says why instead of showing a placeholder number.
# ============================================================================

# ---------------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------------

# Finnhub - US equity and ETF quotes, company news, symbol search.
#   Free tier: 60 calls/minute. Sign up at https://finnhub.io/register
#   Without this: no equity or index quotes, no company news.
#   Note: /stock/candle moved to a paid plan, so charts come from Alpha Vantage.
FINNHUB_API_KEY=

# Alpha Vantage - equity, ETF and FX candles; fallback quotes.
#   Free tier: 25 calls/DAY, 5/minute. https://www.alphavantage.co/support/#api-key
#   Without this: no charts, no Outlook and no backtest for equities or indices.
#   The 25/day ceiling is why daily bars are cached for four hours.
ALPHAVANTAGE_API_KEY=

# CoinGecko - crypto. The public API needs no key; a key only raises the limits.
#   Demo key: https://www.coingecko.com/en/developers/dashboard
#   Set COINGECKO_PLAN=pro only if you hold a paid key (it switches the base URL
#   and unlocks daily crypto history beyond 30 days).
COINGECKO_API_KEY=
COINGECKO_PLAN=demo

# exchangerate.host - FX. Optional: without it, FX falls back to Frankfurter
#   (ECB daily reference rates, keyless), which is what ships working by default.
EXCHANGERATE_API_KEY=

# News RSS feeds, comma-separated. Leave blank for the built-in list
# (Reuters Business, FT, CoinDesk, WSJ Markets).
NEWS_RSS_FEEDS=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

DATABASE_URL=./data/gmt.db
# GMT_CACHE_DIR=./.cache
# GMT_CACHE_MAX_AGE_MS=604800000       # 7 days: older entries are never served
# GMT_HTTP_TIMEOUT_MS=12000

# ---------------------------------------------------------------------------
# Bot gateway - hard limits, enforced server-side
#
# These are the guardrails around an untrusted agent. They are read by the
# gateway on every order and cannot be read or changed by the bot. Breaching any
# of them LOCKS the gateway until a human clears it on the /bot screen.
# ---------------------------------------------------------------------------
# Operator console
# ---------------------------------------------------------------------------
# Secret that gates /bot and every /api/admin route: live-order approvals, token
# issue and revoke, clearing a locked gateway, and the audit log. Required --
# with it unset those controls refuse to serve rather than answering anyone who
# can reach the port, which includes the bot they exist to contain. Use a long
# random value, e.g. `openssl rand -hex 32`.
GMT_ADMIN_TOKEN=

# ---------------------------------------------------------------------------

# Instruments the bot may trade or quote. Comma-separated, canonical symbols.
# An empty value falls back to a built-in list; it never means "everything".
GMT_INSTRUMENT_ALLOWLIST=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,JPM,XOM,SPY,BTC-USD,ETH-USD,SOL-USD,EUR/USD,GBP/USD,USD/JPY

GMT_MAX_ORDER_NOTIONAL=10000           # largest single order, in account currency
GMT_MAX_POSITION_NOTIONAL=25000        # largest any one position may reach
GMT_MAX_POSITION_PERCENT_EQUITY=20     # concentration cap, percent of equity
GMT_MAX_DAILY_LOSS=2500                # realised loss for the UTC day that stops trading
GMT_MAX_ORDERS_PER_MINUTE=10
GMT_MAX_ORDERS_PER_DAY=200

# Starting cash for the seeded paper account.
GMT_PAPER_STARTING_CASH=100000

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------

# How many S&P 500 constituents to price for the heatmap and movers on each
# load. Higher gives better coverage and burns more rate budget.
GMT_HEATMAP_SYMBOLS=60

# Worker intervals, in milliseconds.
GMT_WORKER_NEWS_MS=300000
GMT_WORKER_CANDLE_MS=1800000

# ---------------------------------------------------------------------------
# There is deliberately no broker API key here.
#
# v1 has no real-money execution path. Order intents flagged `live` queue for
# human approval and then stop: no broker adapter exists for an approved intent
# to route to. Do not add broker credentials to this file -- the gateway is not
# built to hold them, and the bot token must never be able to reach them.
# ---------------------------------------------------------------------------
